    "const DATA_DIR = process.env.DATA_DIR || \"/data\";",
    "const CHROME = process.env.CHROMIUM_PATH || \"/usr/bin/chromium\";",
    "const DISPLAY = process.env.DISPLAY || \":99\";"
  ]

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jason-home-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "HOME", "class_name": "JasonHomeController" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["JasonHomeController"] }
  ],
  "observability": { "enabled": true }
}

EUFY_EMAIL=replace-with-eufy-email
EUFY_PASSWORD=replace-with-eufy-password
JASON_HOME_API_TOKEN=replace-with-long-random-token
HOME_LAT=42.1507
HOME_LON=-78.9452
HOME_TZ=America/New_York
PORT=8080
JASON_HOME_DB=/data/jason-home.sqlite
# Optional: 32 hex characters. If omitted, the server derives a stable install ID.
# EUFY_INSTALL_ID=

# MQTT transport: persistent keeps one warm session per light. Set to individual to restore the legacy per-command connection path.
JASON_HOME_MQTT_CONNECTION_MODE=persistent

# Native ESP-IDF Jason Home 2 bridge: retain Oracle/manual OTA and restore non-destructive controls.
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_SIZE=768
# The original phone's 5 catalog notifications arrive in <20 ms.
# 1.1.28 reliably received 350/364/163 but not 370/396-byte values.
# Increase ACL host and controller buffers for the burst; do not weaken MTU.
CONFIG_BT_NIMBLE_TRANSPORT_ACL_SIZE=517
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=64
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=64
CONFIG_BT_LE_MSYS_2_BLOCK_COUNT=64
CONFIG_BT_LE_ACL_BUF_COUNT=48
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Reduce embedded assertion strings without removing runtime safety checks.
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_COMPILER_OPTIMIZATION_CHECKS_SILENT=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL_WARN=y

# RX8: on ESP32-C6 with NimBLE, BT_LE_MSYS settings are intentionally disabled.
# Enlarge the active NimBLE RX block to carry 396-byte notifications plus overhead.

# Feature parity: power/brightness/effects/streams/sequence commands active.
# Destructive 2909 and file upload remain separately guarded.
CONFIG_JH2_NATIVE_READONLY_ACCEPTANCE=n

# Bootloader rejects unconfirmed updates and selects previous valid runtime.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BOOTLOADER_WDT_ENABLE=y
CONFIG_BOOTLOADER_WDT_TIME_MS=9000

# PuTTY 2026-10-25: main-task stack protection fault before setup Wi-Fi.
# Preserve independent Wi-Fi startup and provide headroom for native bridge initialization.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

menu "Jason Home 2 native runtime"
    config JH2_NATIVE_ENABLE_ORACLE
        bool "Enable native outbound Oracle bridge (requires acceptance testing)"
        default n
        help
            Do not enable on production until 88 SmartDawn catalog
            entries, signed OTA, command ACK and image streaming have
            been validated on physical ESP32-C6 hardware.
    config JH2_NATIVE_READONLY_ACCEPTANCE
        bool "Restrict native Oracle commands to inventory diagnostics"
        default y
        help
            Preserve factory curtain data during physical acceptance.
            Allow only BLE catalog/status/connect and read-only rawWrite
            205/167/2904. Reject display writes, asset playback and OTA.
            Disabling this gate requires a separate verified production build.
    config JH2_NATIVE_BROWSER_OTA_COMPAT
        bool "Embed original Jason Home 2 browser OTA identity and sizing"
        default n
        help
            Compatibility for the existing factory browser's local
            runtime upload. No remote signing key is used. Build-only
            until acceptance on physical hardware.
endmenu
